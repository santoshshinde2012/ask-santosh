# Copy to .env and fill in. Works with any OpenAI-compatible provider.

# --- OpenAI (default) ---
OPENAI_API_KEY=sk-...

# --- GitHub Models (no separate key; uses your GITHUB_TOKEN) ---
# OPENAI_BASE_URL=https://models.inference.ai.azure.com
# GITHUB_TOKEN=ghp_...
# CHAT_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small

# --- Local (Ollama / LocalAI / vLLM) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# CHAT_MODEL=llama3.1
# EMBED_MODEL=nomic-embed-text

# --- Content to index (comma-separated RSS/Atom feeds) ---
FEEDS=https://medium.com/feed/@santosh-shinde

# --- Retrieval tuning (optional) ---
# TOP_K=4
# CHUNK_CHARS=900
